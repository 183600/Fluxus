)\n\n# 25. \20869\23384\31649\29702\21644\24369\24341\29992\nimport weakref\n\nclass BigObject:\n    def __del__(self):\n        print(\"BigObject \34987\38144\27585\")\n\nobj = BigObject()\nweak_ref = weakref.ref(obj)\n\nprint(f\"\23545\35937\26159\21542\23384\27963: {weak_ref() is not None}\")\ndel obj\nprint(f\"\23545\35937\26159\21542\23384\27963: {weak_ref() is not None}\")\n\n# 26. \24207\21015\21270\21644pickle\nimport pickle\n\n# \24207\21015\21270\23545\35937\ndata = {\"name\": \"Alice\", \"age\": 30, \"scores\": [85, 90, 95]}\n\nwith open(\"data.pkl\", \"wb\") as f:\n    pickle.dump(data, f)\n\n# \21453\24207\21015\21270\23545\35937\nwith open(\"data.pkl\", \"rb\") as f:\n    loaded_data = pickle.load(f)\n\nprint(f\"\21453\24207\21015\21270\30340\25968\25454: {loaded_data}\")\n\n# 27. \19978\19979\25991\21464\37327\nimport contextvars\n\nuser_var = contextvars.ContextVar('user', default='Anonymous')\n\ndef process_request():\n    user = user_var.get()\n    print(f\"\22788\29702\35831\27714\65292\29992\25143: {user}\")\n\n# \35774\32622\19978\19979\25991\21464\37327\ntoken = user_var.set(\"Alice\")\nprocess_request()\n\n# \37325\32622\19978\19979\25991\21464\37327\nuser_var.reset(token)\nprocess_request()\n\n# 28. \32467\26500\21270\27169\24335\21305\37197 (Python 3.10+)\ndef match_example(value):\n    match value:\n        case 0:\n            print(\"\38646\")\n        case 1:\n            print(\"\19968\")\n        case [x, y]:\n            print(f\"\21015\34920\65292\20803\32032: {x}, {y}\")\n        case {\"name\": name, \"age\": age}:\n            print(f\"\23383\20856\65292\22995\21517: {name}, \24180\40836: {age}\")\n        case _:\n            print(\"\20854\20182\")\n\nmatch_example(0)\nmatch_example([1, 2])\nmatch_example({\"name\": \"Bob\", \"age\": 25})\nmatch_example(\"test\")\n\n# 29. \36171\20540\34920\36798\24335 (\28023\35937\36816\31639\31526)\nnumbers = [1, 2, 3, 4, 5]\nwhile (n := len(numbers)) > 0:\n    popped = numbers.pop()\n    print(f\"\24377\20986: {popped}, \21097\20313: {n-1}\")\n\n# 30. \20301\32622\21442\25968\21644\20851\38190\23383\21442\25968\ndef example_func(a, b, /, c, d, *, e, f):\n    \"\"\"\23637\31034\19981\21516\31867\22411\30340\21442\25968:\n    - a, b: \20165\20301\32622\21442\25968\n    - c, d: \20301\32622\25110\20851\38190\23383\21442\25968\n    - e, f: \20165\20851\38190\23383\21442\25968\n    \"\"\"\n    print(f\"a={a}, b={b}, c={c}, d={d}, e={e}, f={f}\")\n\nexample_func(1, 2, 3, d=4, e=5, f=6)\n\n# 31. \20301\32622\21442\25968\35299\21253\ndef add(a, b, c):\n    return a + b + c\n\nvalues = [1, 2, 3]\nresult = add(*values)\nprint(f\"\35299\21253\32467\26524: {result}\")\n\n# 32. \20851\38190\23383\21442\25968\35299\21253\ndef greet(name, greeting):\n    return f\"{greeting}, {name}!\"\n\nparams = {\"name\": \"Alice\", \"greeting\": \"Hello\"}\nresult = greet(**params)\nprint(f\"\20851\38190\23383\35299\21253\32467\26524: {result}\")\n\n# 33. \38142\24335\27604\36739\nx = 10\nif 0 < x < 20:\n    print(\"x \22312 0 \21644 20 \20043\38388\")\n\n# 34. \20301\36816\31639\na = 60  # 0011 1100\nb = 13  # 0000 1101\n\nprint(f\"a & b = {a & b}\")   # 12 (0000 1100)\nprint(f\"a | b = {a | b}\")   # 61 (0011 1101)\nprint(f\"a ^ b = {a ^ b}\")   # 49 (0011 0001)\nprint(f\"~a = {~a}\")         # -61 (1100 0011)\nprint(f\"a << 2 = {a << 2}\") # 240 (1111 0000)\nprint(f\"a >> 2 = {a >> 2}\") # 15 (0000 1111)\n\n# 35. \36816\31639\31526\37325\36733\nclass Vector:\n    \"\"\"\21521\37327\31867\65292\23637\31034\36816\31639\31526\37325\36733\"\"\"\n    def __init__(self, x, y):\n        self.x = x\n        self.y = y\n    \n    def __add__(self, other):\n        return Vector(self.x + other.x, self.y + other.y)\n    \n    def __sub__(self, other):\n        return Vector(self.x - other.x, self.y - other.y)\n    \n    def __mul__(self, scalar):\n        return Vector(self.x * scalar, self.y * scalar)\n    \n    def __eq__(self, other):\n        return self.x == other.x and self.y == other.y\n    \n    def __str__(self):\n        return f\"Vector({self.x}, {self.y})\"\n\nv1 = Vector(1, 2)\nv2 = Vector(3, 4)\n\nprint(f\"v1 + v2 = {v1 + v2}\")\nprint(f\"v1 - v2 = {v1 - v2}\")\nprint(f\"v1 * 3 = {v1 * 3}\")\nprint(f\"v1 == v2 = {v1 == v2}\")\n\n# 36. \21333\20363\27169\24335\nclass Singleton:\n    _instance = None\n    \n    def __new__(cls):\n        if cls._instance is None:\n            cls._instance = super().__new__(cls)\n        return cls._instance\n\ns1 = Singleton()\ns2 = Singleton()\nprint(f\"s1 \26159 s2: {s1 is s2}\")\n\n# 37. \24037\21378\27169\24335\nclass Dog:\n    def speak(self):\n        return \"Woof!\"\n\nclass Cat:\n    def speak(self):\n        return \"Meow!\"\n\ndef animal_factory(animal_type):\n    \"\"\"\21160\29289\24037\21378\"\"\"\n    if animal_type == \"dog\":\n        return Dog()\n    elif animal_type == \"cat\":\n        return Cat()\n    else:\n        raise ValueError(f\"\26410\30693\21160\29289\31867\22411: {animal_type}\")\n\ndog = animal_factory(\"dog\")\ncat = animal_factory(\"cat\")\nprint(f\"\29399\35828: {dog.speak()}\")\nprint(f\"\29483\35828: {cat.speak()}\")\n\n# 38. \35266\23519\32773\27169\24335\nclass Subject:\n    \"\"\"\20027\39064\65288\34987\35266\23519\32773\65289\"\"\"\n    def __init__(self):\n        self._observers = []\n        self._state = None\n    \n    def attach(self, observer):\n        if observer not in self._observers:\n            self._observers.append(observer)\n    \n    def detach(self, observer):\n        try:\n            self._observers.remove(observer)\n        except ValueError:\n            pass\n    \n    def notify(self):\n        for observer in self._observers:\n            observer.update(self)\n    \n    @property\n    def state(self):\n        return self._state\n    \n    @state.setter\n    def state(self, value):\n        self._state = value\n        self.notify()\n\nclass Observer:\n    \"\"\"\35266\23519\32773\"\"\"\n    def update(self, subject):\n        print(f\"\35266\23519\32773\25910\21040\26356\26032: {subject.state}\")\n\nsubject = Subject()\nobserver1 = Observer()\nobserver2 = Observer()\n\nsubject.attach(observer1)\nsubject.attach(observer2)\n\nsubject.state = \"\26032\29366\24577\"\n\n# 39. \31574\30053\27169\24335\nclass Strategy:\n    \"\"\"\31574\30053\22522\31867\"\"\"\n    def execute(self, a, b):\n        pass\n\nclass AddStrategy(Strategy):\n    def execute(self, a, b):\n        return a + b\n\nclass SubtractStrategy(Strategy):\n    def execute(self, a, b):\n        return a - b\n\nclass MultiplyStrategy(Strategy):\n    def execute(self, a, b):\n        return a * b\n\nclass Context:\n    \"\"\"\19978\19979\25991\"\"\"\n    def __init__(self, strategy):\n        self._strategy = strategy\n    \n    def set_strategy(self, strategy):\n        self._strategy = strategy\n    \n    def execute_strategy(self, a, b):\n        return self._strategy.execute(a, b)\n\ncontext = Context(AddStrategy())\nprint(f\"\21152\27861: {context.execute_strategy(5, 3)}\")\n\ncontext.set_strategy(SubtractStrategy())\nprint(f\"\20943\27861: {context.execute_strategy(5, 3)}\")\n\ncontext.set_strategy(MultiplyStrategy())\nprint(f\"\20056\27861: {context.execute_strategy(5, 3)}\")\n\n# 40. \35013\39280\22120\27169\24335\nclass Coffee:\n    \"\"\"\21654\21857\22522\31867\"\"\"\n    def cost(self):\n        return 5\n    \n    def description(self):\n        return \"\22522\30784\21654\21857\"\n\nclass MilkDecorator:\n    \"\"\"\29275\22902\35013\39280\22120\"\"\"\n    def __init__(self, coffee):\n        self._coffee = coffee\n    \n    def cost(self):\n        return self._coffee.cost() + 2\n    \n    def description(self):\n        return self._coffee.description() + \", \29275\22902\"\n\nclass SugarDecorator:\n    \"\"\"\31958\35013\39280\22120\"\"\"\n    def __init__(self, coffee):\n        self._coffee = coffee\n    \n    def cost(self):\n        return self._coffee.cost() + 1\n    \n    def description(self):\n        return self._coffee.description() + \", \31958\"\n\ncoffee = Coffee()\nprint(f\"{coffee.description()}: ${coffee.cost()}\")\n\ncoffee_with_milk = MilkDecorator(coffee)\nprint(f\"{coffee_with_milk.description()}: ${coffee_with_milk.cost()}\")\n\ncoffee_with_milk_and_sugar = SugarDecorator(coffee_with_milk)\nprint(f\"{coffee_with_milk_and_sugar.description()}: ${coffee_with_milk_and_sugar.cost()}\")\n\n# 41. \19978\19979\25991\31649\29702\22120\35013\39280\22120\nfrom contextlib import contextmanager\n\n@contextmanager\ndef managed_resource(resource_name):\n    \"\"\"\19978\19979\25991\31649\29702\22120\35013\39280\22120\31034\20363\"\"\"\n    print(f\"\33719\21462\36164\28304: {resource_name}\")\n    try:\n        yield resource_name\n    finally:\n        print(f\"\37322\25918\36164\28304: {resource_name}\")\n\nwith managed_resource(\"\25968\25454\24211\36830\25509\"):\n    print(\"\20351\29992\36164\28304\")\n\n# 42. \20989\25968\27880\35299\ndef calculate(\n    a: float,\n    b: float,\n    operation: str = \"add\"\n) -> float:\n    \"\"\"\24102\35814\32454\27880\35299\30340\20989\25968\"\"\"\n    if operation == \"add\":\n        return a + b\n    elif operation == \"subtract\":\n        return a - b\n    elif operation == \"multiply\":\n        return a * b\n    elif operation == \"divide\":\n        return a / b\n    else:\n        raise ValueError(f\"\26410\30693\25805\20316: {operation}\")\n\n# 43. \31867\22411\21035\21517\nfrom typing import List, Dict\n\nVector = List[float]\nMatrix = List[Vector]\nUserInfo = Dict[str, Union[str, int, List[int]]]\n\ndef dot_product(v1: Vector, v2: Vector) -> float:\n    \"\"\"\35745\31639\21521\37327\28857\31215\"\"\"\n    return sum(x * y for x, y in zip(v1, v2))\n\n# 44. \27867\22411\nfrom typing import TypeVar, Generic\n\nT = TypeVar('T')\n\nclass Stack(Generic[T]):\n    \"\"\"\27867\22411\26632\31867\"\"\"\n    def __init__(self):\n        self._items = []\n    \n    def push(self, item: T) -> None:\n        self._items.append(item)\n    \n    def pop(self) -> T:\n        return self._items.pop()\n    \n    def is_empty(self) -> bool:\n        return len(self._items) == 0\n\n# \20351\29992\27867\22411\26632\nint_stack = Stack[int]()\nint_stack.push(1)\nint_stack.push(2)\nprint(f\"\24377\20986\25972\25968: {int_stack.pop()}\")\n\nstr_stack = Stack[str]()\nstr_stack.push(\"Hello\")\nstr_stack.push(\"World\")\nprint(f\"\24377\20986\23383\31526\20018: {str_stack.pop()}\")\n\n# 45. \21327\35758\nfrom typing import Protocol\n\nclass Drawable(Protocol):\n    def draw(self) -> str:\n        ...\n\nclass Circle:\n    def draw(self) -> str:\n        return \"\32472\21046\22278\24418\"\n\nclass Square:\n    def draw(self) -> str:\n        return \"\32472\21046\27491\26041\24418\"\n\ndef render_shape(shape: Drawable) -> None:\n    print(shape.draw())\n\ncircle = Circle()\nsquare = Square()\n\nrender_shape(circle)\nrender_shape(square)\n\n# 46. \21487\35843\29992\23545\35937\nclass Adder:\n    def __init__(self, n):\n        self.n = n\n    \n    def __call__(self, x):\n        return self.n + x\n\nadd5 = Adder(5)\nprint(f\"5 + 3 = {add5(3)}\")\n\n# 47. \25551\36848\31526\21327\35758\nclass ValidatedAttribute:\n    \"\"\"\39564\35777\23646\24615\25551\36848\31526\"\"\"\n    def __init__(self, name, type_, default=None):\n        self.name = name\n        self.type_ = type_\n        self.default = default\n    \n    def __get__(self, obj, objtype=None):\n        if obj is None:\n            return self\n        value = obj.__dict__.get(self.name, self.default)\n        if value is None:\n            return None\n        if not isinstance(value, self.type_):\n            raise TypeError(f\"{self.name} \24517\39035\26159 {self.type_}\")\n        return value\n    \n    def __set__(self, obj, value):\n        if value is not None and not isinstance(value, self.type_):\n            raise TypeError(f\"{self.name} \24517\39035\26159 {self.type_}\")\n        obj.__dict__[self.name] = value\n\nclass Person:\n    name = ValidatedAttribute(\"name\", str)\n    age = ValidatedAttribute(\"age\", int, 0)\n    height = ValidatedAttribute(\"height\", float)\n\nperson = Person()\nperson.name = \"Alice\"\nperson.age = 30\nperson.height = 170.5\n\nprint(f\"\22995\21517: {person.name}, \24180\40836: {person.age}, \36523\39640: {person.height}\")\n\ntry:\n    person.age = \"\19977\21313\"  # \36825\23558\24341\21457TypeError\nexcept TypeError as e:\n    print(f\"\38169\35823: {e}\")\n\n# 48. \19978\19979\25991\31649\29702\22120\21327\35758\nclass Timer:\n    \"\"\"\35745\26102\22120\19978\19979\25991\31649\29702\22120\"\"\"\n    def __init__(self, name):\n        self.name = name\n        self.start = None\n        self.end = None\n    \n    def __enter__(self):\n        import time\n        self.start = time.time()\n        return self\n    \n    def __exit__(self, exc_type, exc_val, exc_tb):\n        import time\n        self.end = time.time()\n        elapsed = self.end - self.start\n        print(f\"{self.name} \32791\26102: {elapsed:.5f}\31186\")\n        return False  # \19981\25233\21046\24322\24120\n\nwith Timer(\"\20195\30721\22359\"):\n    import time\n    time.sleep(0.1)\n\n# 49. \36845\20195\22120\21327\35758\nclass Fibonacci:\n    \"\"\"\26000\27874\37027\22865\25968\21015\36845\20195\22120\"\"\"\n    def __init__(self, max_count):\n        self.max_count = max_count\n        self.count = 0\n        self.a, self.b = 0, 1\n    \n    def __iter__(self):\n        return self\n    \n    def __next__(self):\n        if self.count >= self.max_count:\n            raise StopIteration\n        self.count += 1\n        result = self.a\n        self.a, self.b = self.b, self.a + self.b\n        return result\n\nfor num in Fibonacci(10):\n    print(f\"\26000\27874\37027\22865\25968: {num}\")\n\n# 50. \21487\36845\20195\23545\35937\21327\35758\nclass Range:\n    \"\"\"\33258\23450\20041\33539\22260\31867\"\"\"\n    def __init__(self, start, end, step=1):\n        self.start = start\n        self.end = end\n        self.step = step\n    \n    def __iter__(self):\n        return RangeIterator(self.start, self.end, self.step)\n\nclass RangeIterator:\n    \"\"\"\33539\22260\36845\20195\22120\"\"\"\n    def __init__(self, start, end, step):\n        self.current = start\n        self.end = end\n        self.step = step\n    \n    def __iter__(self):\n        return self\n    \n    def __next__(self):\n        if self.step > 0 and self.current >= self.end:\n            raise StopIteration\n        if self.step < 0 and self.current <= self.end:\n            raise StopIteration\n        \n        result = self.current\n        self.current += self.step\n        return result\n\nfor i in Range(1, 5):\n    print(f\"\33539\22260\25968: {i}\")\n\nfor i in Range(5, 0, -1):\n    print(f\"\20498\24207\33539\22260\25968: {i}\")\n\n# 51. \29983\25104\22120\34920\36798\24335\21644yield from\ndef chain(*iterables):\n    \"\"\"\36830\25509\22810\20010\21487\36845\20195\23545\35937\"\"\"\n    for it in iterables:\n        yield from it\n\nfor item in chain([1, 2], ['a', 'b'], [3, 4]):\n    print(f\"\38142\24335\39033: {item}\")\n\n# 52. \21327\31243\21644\24322\27493\29983\25104\22120\nasync def async_range(n):\n    \"\"\"\24322\27493\29983\25104\22120\"\"\"\n    for i in range(n):\n        yield i\n        await asyncio.sleep(0.1)\n\nasync def async_main():\n    \"\"\"\24322\27493\20027\20989\25968\"\"\"\n    async for num in async_range(5):\n        print(f\"\24322\27493\25968: {num}\")\n\n# asyncio.run(async_main())  # \27880\37322\25481\65292\36991\20813\22312\27979\35797\26102\36816\34892\n\n# 53. \31867\22411\26816\26597\nimport typing\n\ndef check_type(value, expected_type):\n    \"\"\"\26816\26597\20540\26159\21542\31526\21512\39044\26399\31867\22411\"\"\"\n    if not isinstance(value, expected_type):\n        raise TypeError(f\"\26399\26395 {expected_type}, \24471\21040 {type(value)}\")\n    return True\n\n# \20351\29992\31034\20363\ncheck_type(42, int)\ncheck_type(\"hello\", str)\n\ntry:\n    check_type(3.14, int)\nexcept TypeError as e:\n    print(f\"\31867\22411\38169\35823: {e}\")\n\n# 54. \24615\33021\20998\26512\nimport timeit\n\ndef test_performance():\n    \"\"\"\27979\35797\24615\33021\30340\20989\25968\"\"\"\n    total = 0\n    for i in range(1000):\n        total += i\n    return total\n\n# \27979\37327\25191\34892\26102\38388\nexecution_time = timeit.timeit(test_performance, number=1000)\nprint(f\"\25191\34892\26102\38388: {execution_time:.5f}\31186\")\n\n# 55. \20869\23384\20998\26512\nimport sys\n\ndef get_size(obj):\n    \"\"\"\33719\21462\23545\35937\22823\23567\"\"\"\n    return sys.getsizeof(obj)\n\nprint(f\"\25972\25968\22823\23567: {get_size(42)} \23383\33410\")\nprint(f\"\23383\31526\20018\22823\23567: {get_size('hello')} \23383\33410\")\nprint(f\"\21015\34920\22823\23567: {get_size([1, 2, 3])} \23383\33410\")\n\n# 56. \20195\30721\23545\35937\21644\21160\24577\25191\34892\ncode_str = \"\"\"\ndef dynamic_function(x, y):\n    return x + y\n\nresult = dynamic_function(10, 20)\nprint(f\"\21160\24577\25191\34892\32467\26524: {result}\")\n\"\"\"\n\n# \32534\35793\24182\25191\34892\20195\30721\ncode_obj = compile(code_str, \"<string>\", \"exec\")\nexec(code_obj)\n\n# 57. \20989\25968\23646\24615\ndef example_function():\n    \"\"\"\31034\20363\20989\25968\"\"\"\n    pass\n\n# \35774\32622\20989\25968\23646\24615\nexample_function.author = \"Alice\"\nexample_function.version = \"1.0\"\n\nprint(f\"\20989\25968\20316\32773: {example_function.author}\")\nprint(f\"\20989\25968\29256\26412: {example_function.version}\")\n\n# 58. \38381\21253\20013\30340\21464\37327\20316\29992\22495\ndef outer_function(x):\n    def inner_function(y):\n        return x + y\n    return inner_function\n\nadd5 = outer_function(5)\nprint(f\"\38381\21253\32467\26524: {add5(10)}\")\n\n# 59. nonlocal\21644global\20851\38190\23383\nx = 10  # \20840\23616\21464\37327\n\ndef modify_global():\n    global x\n    x = 20\n    print(f\"\20869\37096\20462\25913\20840\23616\21464\37327: {x}\")\n\ndef outer():\n    x = 5  # \22806\23618\20989\25968\21464\37327\n    \n    def inner():\n        nonlocal x\n        x = 10\n        print(f\"\20869\37096\20462\25913\22806\23618\21464\37327: {x}\")\n    \n    print(f\"\20462\25913\21069\22806\23618\21464\37327: {x}\")\n    inner()\n    print(f\"\20462\25913\21518\22806\23618\21464\37327: {x}\")\n\nprint(f\"\20840\23616\21464\37327\21021\22987\20540: {x}\")\nmodify_global()\nprint(f\"\20840\23616\21464\37327\20462\25913\21518: {x}\")\nouter()\n\n# 60. \20803\32452\35299\21253\na, b, c = (1, 2, 3)\nprint(f\"\20803\32452\35299\21253: a={a}, b={b}, c={c}\")\n\n# \20132\25442\21464\37327\na, b = b, a\nprint(f\"\20132\25442\21518: a={a}, b={b}\")\n\n# 61. \26143\21495\35299\21253\nfirst, *middle, last = [1, 2, 3, 4, 5]\nprint(f\"\39318\39033: {first}, \20013\38388\39033: {middle}, \26411\39033: {last}\")\n\n# 62. \23383\20856\35299\21253\ndict1 = {\"a\": 1, \"b\": 2}\ndict2 = {\"c\": 3, \"d\": 4}\nmerged_dict = {**dict1, **dict2}\nprint(f\"\21512\24182\23383\20856: {merged_dict}\")\n\n# 63. \38598\21512\25805\20316\nset1 = {1, 2, 3}\nset2 = {3, 4, 5}\n\nprint(f\"\24182\38598: {set1 | set2}\")\nprint(f\"\20132\38598: {set1 & set2}\")\nprint(f\"\24046\38598: {set1 - set2}\")\nprint(f\"\23545\31216\24046\38598: {set1 ^ set2}\")\n\n# 64. \21015\34920\26041\27861\nnumbers = [1, 2, 3, 4, 5]\nnumbers.append(6)\nnumbers.insert(0, 0)\nnumbers.extend([7, 8, 9])\nnumbers.remove(3)\npopped = numbers.pop()\nprint(f\"\24377\20986\20803\32032: {popped}\")\nprint(f\"\21015\34920: {numbers}\")\nprint(f\"\32034\24341: {numbers.index(4)}\")\nprint(f\"\35745\25968: {numbers.count(2)}\")\nnumbers.sort()\nprint(f\"\25490\24207\21518: {numbers}\")\nnumbers.reverse()\nprint(f\"\21453\36716\21518: {numbers}\")\n\n# 65. \23383\20856\26041\27861\nstudent = {\"name\": \"Alice\", \"age\": 25, \"courses\": [\"Math\", \"Science\"]}\nprint(f\"\38190: {student.keys()}\")\nprint(f\"\20540: {student.values()}\")\nprint(f\"\38190\20540\23545: {student.items()}\")\nprint(f\"\33719\21462\22995\21517: {student.get('name')}\")\nprint(f\"\33719\21462\25104\32489: {student.get('grades', 'N/A')}\")\nstudent.update({\"age\": 26, \"grades\": [85, 90, 95]})\nprint(f\"\26356\26032\21518: {student}\")\nremoved = student.pop('courses')\nprint(f\"\31227\38500\30340\35838\31243: {removed}\")\nprint(f\"\26368\32456\23383\20856: {student}\")\n\n# 66. \23383\31526\20018\26041\27861\ntext = \"  Hello, World!  \"\nprint(f\"\21435\38500\31354\30333: '{text.strip()}'\")\nprint(f\"\22823\20889: '{text.upper()}'\")\nprint(f\"\23567\20889: '{text.lower()}'\")\nprint(f\"\26367\25442: '{text.replace('World', 'Python')}'\")\nprint(f\"\20998\21106: '{text.split(',')}'\")\nprint(f\"\36830\25509: {'-'.join(['a', 'b', 'c'])}\")\nprint(f\"\26597\25214: '{text.find('World')}'\")\nprint(f\"\35745\25968: '{text.count('l')}'\")\nprint(f\"\26159\21542\20197Hello\24320\22836: {text.strip().startswith('Hello')}\")\nprint(f\"\26159\21542\20197World\32467\23614: {text.strip().endswith('World')}\")\n\n# 67. \26684\24335\21270\23383\31526\20018\nname = \"Alice\"\nage = 30\nheight = 1.65\n\n# f-strings (Python 3.6+)\nprint(f\"\22995\21517: {name}, \24180\40836: {age}, \36523\39640: {height:.2f}\31859\")\n\n# str.format()\nprint(\"\22995\21517: {}, \24180\40836: {}, \36523\39640: {:.2f}\31859\".format(name, age, height))\n\n# %\26684\24335\21270\nprint(\"\22995\21517: %s, \24180\40836: %d, \36523\39640: %.2f\31859\" % (name, age, height))\n\n# 68. \25991\20214\21644\30446\24405\25805\20316\nimport os\n\n# \33719\21462\24403\21069\24037\20316\30446\24405\nprint(f\"\24403\21069\24037\20316\30446\24405: {os.getcwd()}\")\n\n# \21015\20986\30446\24405\20869\23481\nprint(f\"\30446\24405\20869\23481: {os.listdir('.')}\")\n\n# \21019\24314\30446\24405\nos.makedirs(\"test_dir\", exist_ok=True)\n\n# \26816\26597\36335\24452\26159\21542\23384\22312\nprint(f\"test_dir\26159\21542\23384\22312: {os.path.exists('test_dir')}\")\n\n# \26816\26597\26159\21542\26159\30446\24405\nprint(f\"test_dir\26159\30446\24405: {os.path.isdir('test_dir')}\")\n\n# \26816\26597\26159\21542\26159\25991\20214\nprint(f\"test_dir\26159\25991\20214: {os.path.isfile('test_dir')}\")\n\n# \33719\21462\25991\20214\22823\23567\nwith open(\"test_file.txt\", \"w\") as f:\n    f.write(\"Hello, World!\")\nprint(f\"\25991\20214\22823\23567: {os.path.getsize('test_file.txt')} \23383\33410\")\n\n# \21024\38500\25991\20214\nos.remove(\"test_file.txt\")\n\n# \21024\38500\30446\24405\nos.rmdir(\"test_dir\")\n\n# 69. \36335\24452\25805\20316\nfrom pathlib import Path\n\n# \21019\24314Path\23545\35937\ncurrent_dir = Path(\".\")\nhome_dir = Path.home()\n\nprint(f\"\24403\21069\30446\24405: {current_dir.resolve()}\")\nprint(f\"\23478\30446\24405: {home_dir}\")\n\n# \21019\24314\36335\24452\nnew_dir = current_dir / \"example_dir\"\nnew_dir.mkdir(exist_ok=True)\n\n# \21019\24314\25991\20214\nfile_path = new_dir / \"example.txt\"\nfile_path.write_text(\"Hello, Path!\")\n\n# \35835\21462\25991\20214\nprint(f\"\25991\20214\20869\23481: {file_path.read_text()}\")\n\n# \36941\21382\30446\24405\nprint(\"\30446\24405\36941\21382:\")\nfor item in new_dir.iterdir():\n    print(f\"  {item.name}: {'\30446\24405' if item.is_dir() else '\25991\20214'}\")\n\n# \28165\29702\nfile_path.unlink()\nnew_dir.rmdir()\n\n# 70. \29615\22659\21464\37327\nimport os\n\n# \33719\21462\29615\22659\21464\37327\nprint(f\"PATH: {os.environ.get('PATH', '\26410\35774\32622')}\")\n\n# \35774\32622\29615\22659\21464\37327\nos.environ['MY_VAR'] = 'my_value'\nprint(f\"MY_VAR: {os.environ.get('MY_VAR')}\")\n\n# \21024\38500\29615\22659\21464\37327\nif 'MY_VAR' in os.environ:\n    del os.environ['MY_VAR']\nprint(f\"MY_VAR\21024\38500\21518: {os.environ.get('MY_VAR', '\26410\35774\32622')}\")\n\n# 71. \21629\20196\34892\21442\25968\nimport sys\n\n# \33719\21462\21629\20196\34892\21442\25968\nprint(f\"\33050\26412\21517\31216: {sys.argv[0]}\")\nprint(f\"\21442\25968\21015\34920: {sys.argv[1:]}\")\n\n# 72. \21629\20196\34892\21442\25968\35299\26512\nimport argparse\n\n# \21019\24314\35299\26512\22120\nparser = argparse.ArgumentParser(description='\31034\20363\33050\26412')\nparser.add_argument('--name', type=str, default='World', help='\22995\21517')\nparser.add_argument('--count', type=int, default=1, help='\35745\25968')\nparser.add_argument('--verbose', action='store_true', help='\35814\32454\36755\20986')\n\n# \27169\25311\35299\26512\21629\20196\34892\21442\25968\n# \22312\23454\38469\20351\29992\20013\65292\36825\20123\21442\25968\26469\33258\21629\20196\34892\nargs = parser.parse_args(['--name', 'Alice', '--count', '3', '--verbose'])\n\nprint(f\"\22995\21517: {args.name}\")\nprint(f\"\35745\25968: {args.count}\")\nprint(f\"\35814\32454\36755\20986: {args.verbose}\")\n\n# 73. \26085\24535\35760\24405\nimport logging\n\n# \37197\32622\26085\24535\nlogging.basicConfig(\n    level=logging.INFO,\n    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'\n)\n\n# \21019\24314\26085\24535\35760\24405\22120\nlogger = logging.getLogger('my_app')\n\n# \35760\24405\19981\21516\32423\21035\30340\26085\24535\nlogger.debug(\"\36825\26159\35843\35797\20449\24687\")\nlogger.info(\"\36825\26159\20449\24687\")\nlogger.warning(\"\36825\26159\35686\21578\")\nlogger.error(\"\36825\26159\38169\35823\")\nlogger.critical(\"\36825\26159\20005\37325\38169\35823\")\n\n# 74. \21333\20803\27979\35797\nimport unittest\n\nclass TestMathOperations(unittest.TestCase):\n    \"\"\"\25968\23398\36816\31639\27979\35797\"\"\"\n    \n    def test_add(self):\n        self.assertEqual(1 + 1, 2)\n    \n    def test_subtract(self):\n        self.assertEqual(5 - 3, 2)\n    \n    def test_multiply(self):\n        self.assertEqual(3 * 4, 12)\n    \n    def test_divide(self):\n        self.assertEqual(10 / 2, 5)\n        with self.assertRaises(ZeroDivisionError):\n            10 / 0\n\n# \36816\34892\27979\35797\n# unittest.main()  # \27880\37322\25481\65292\36991\20813\22312\27979\35797\26102\36816\34892\n\n# 75. doctest\ndef factorial(n):\n    \"\"\"\35745\31639\38454\20056\n    \n    >>> factorial(0)\n    1\n    >>> factorial(1)\n    1\n    >>> factorial(5)\n    120\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"\36127\25968\27809\26377\38454\20056\")\n    result = 1\n    for i in range(1, n + 1):\n        result *= i\n    return result\n\n# \36816\34892doctest\n# import doctest\n# doctest.testmod()  # \27880\37322\25481\65292\36991\20813\22312\27979\35797\26102\36816\34892\n\n# 76. \20869\23384\35270\22270\ndata = bytearray(b'Hello, World')\nmv = memoryview(data)\n\nprint(f\"\20869\23384\35270\22270: {mv}\")\nprint(f\"\21069\&5\20010\23383\33410: {mv[:5].tobytes()}\")\n\n# \20462\25913\25968\25454\ntry:\n    mv[7:12] = b'Python'\n    print(f\"\20462\25913\21518: {data}\")\nexcept ValueError as e:\n    print(f\"\20869\23384\35270\22270\20462\25913\38169\35823: {e}\")\n    print(f\"\21407\22987\25968\25454: {data}\")\n\n# 77. \32467\26500\21270\25968\25454\nimport struct\n\n# \25171\21253\25968\25454\npacked_data = struct.pack('i f s', 42, 3.14, b'Hello')\nprint(f\"\25171\21253\25968\25454: {packed_data}\")\n\n# \35299\21253\25968\25454\nunpacked_data = struct.unpack('i f s', packed_data)\nprint(f\"\35299\21253\25968\25454: {unpacked_data}\")\n\n# 78. \25968\32452\25805\20316\nimport array\n\n# \21019\24314\25968\32452\narr = array.array('i', [1, 2, 3, 4, 5])\nprint(f\"\25968\32452: {arr}\")\n\n# \28155\21152\20803\32032\narr.append(6)\nprint(f\"\28155\21152\21518: {arr}\")\n\n# \25193\23637\25968\32452\narr.extend([7, 8, 9])\nprint(f\"\25193\23637\21518: {arr}\")\n\n# \31227\38500\20803\32032\narr.remove(3)\nprint(f\"\31227\38500\21518: {arr}\")\n\n# 79. \22534\38431\21015\nimport heapq\n\n# \21019\24314\21015\34920\nheap = [3, 1, 4, 1, 5, 9, 2, 6]\nprint(f\"\21407\22987\21015\34920: {heap}\")\n\n# \36716\25442\20026\22534\nheapq.heapify(heap)\nprint(f\"\22534\21270\21518: {heap}\")\n\n# \25512\20837\20803\32032\nheapq.heappush(heap, 0)\nprint(f\"\25512\20837\21518: {heap}\")\n\n# \24377\20986\26368\23567\20803\32032\nmin_item = heapq.heappop(heap)\nprint(f\"\24377\20986\26368\23567\20803\32032: {min_item}\")\nprint(f\"\24377\20986\21518: {heap}\")\n\n# \33719\21462n\20010\26368\23567\20803\32032\nn_smallest = heapq.nsmallest(3, heap)\nprint(f\"3\20010\26368\23567\20803\32032: {n_smallest}\")\n\n# 80. \21452\31471\38431\21015\nfrom collections import deque\n\n# \21019\24314\21452\31471\38431\21015\ndq = deque([1, 2, 3])\nprint(f\"\21452\31471\38431\21015: {dq}\")\n\n# \21491\31471\28155\21152\ndq.append(4)\nprint(f\"\21491\31471\28155\21152\21518: {dq}\")\n\n# \24038\31471\28155\21152\ndq.appendleft(0)\nprint(f\"\24038\31471\28155\21152\21518: {dq}\")\n\n# \21491\31471\31227\38500\nright_item = dq.pop()\nprint(f\"\21491\31471\31227\38500: {right_item}\")\nprint(f\"\21491\31471\31227\38500\21518: {dq}\")\n\n# \24038\31471\31227\38500\nleft_item = dq.popleft()\nprint(f\"\24038\31471\31227\38500: {left_item}\")\nprint(f\"\24038\31471\31227\38500\21518: {dq}\")\n\n# 81. \35745\25968\22120\nfrom collections import Counter\n\n# \21019\24314\35745\25968\22120\ncounter = Counter(['a', 'b', 'a', 'c', 'b', 'a'])\nprint(f\"\35745\25968\22120: {counter}\")\n\n# \35775\38382\35745\25968\nprint(f\"a\30340\35745\25968: {counter['a']}\")\n\n# \26368\24120\35265\30340\20803\32032\nprint(f\"\26368\24120\35265\30340\20803\32032: {counter.most_common(2)}\")\n\n# \26356\26032\35745\25968\ncounter.update(['a', 'b', 'd'])\nprint(f\"\26356\26032\21518: {counter}\")\n\n# 82. \26377\24207\23383\20856\nfrom collections import OrderedDict\n\n# \21019\24314\26377\24207\23383\20856\nod = OrderedDict()\nod['a'] = 1\nod['b'] = 2\nod['c'] = 3\nprint(f\"\26377\24207\23383\20856: {od}\")\n\n# \31227\21160\21040\26411\23614\nod.move_to_end('a')\nprint(f\"\31227\21160a\21040\26411\23614: {od}\")\n\n# \31227\21160\21040\24320\22836\nod.move_to_end('a', last=False)\nprint(f\"\31227\21160a\21040\24320\22836: {od}\")\n\n# \24377\20986\26368\21518\39033\nlast_item = od.popitem()\nprint(f\"\24377\20986\26368\21518\39033: {last_item}\")\nprint(f\"\24377\20986\21518: {od}\")\n\n# 83. \40664\35748\23383\20856\nfrom collections import defaultdict\n\n# \21019\24314\40664\35748\23383\20856\ndd = defaultdict(int)\ndd['a'] += 1\ndd['b'] += 2\nprint(f\"\40664\35748\23383\20856: {dict(dd)}\")\n\n# \20351\29992\21015\34920\20316\20026\40664\35748\24037\21378\ndd_list = defaultdict(list)\ndd_list['a'].append(1)\ndd_list['a'].append(2)\ndd_list['b'].append(3)\nprint(f\"\21015\34920\40664\35748\23383\20856: {dict(dd_list)}\")\n\n# 84. \21629\21517\20803\32452\nfrom collections import namedtuple\n\n# \21019\24314\21629\21517\20803\32452\31867\nPoint = namedtuple('Point', ['x', 'y'])\n\n# \21019\24314\23454\20363\np1 = Point(1, 2)\np2 = Point(3, 4)\n\nprint(f\"\28857\&1: {p1}\")\nprint(f\"\28857\&2: {p2}\")\nprint(f\"x\22352\26631: {p1.x}\")\nprint(f\"y\22352\26631: {p1.y}\")\n\n# 85. \38142\26144\23556\nfrom collections import ChainMap\n\n# \21019\24314\23383\20856\ndict1 = {'a': 1, 'b': 2}\ndict2 = {'b': 3, 'c': 4}\ndict3 = {'d': 5}\n\n# \21019\24314\38142\26144\23556\nchain = ChainMap(dict1, dict2, dict3)\nprint(f\"\38142\26144\23556: {chain}\")\n\n# \26597\25214\38190\nprint(f\"a\30340\20540: {chain['a']}\")\nprint(f\"b\30340\20540: {chain['b']}\")  # \26469\33258dict1\65292\22240\20026\23427\22312\21069\38754\n\n# \28155\21152\26032\26144\23556\nnew_chain = chain.new_child({'e': 6})\nprint(f\"\26032\38142\26144\23556: {new_chain}\")\n\n# 86. \21487\21704\24076\23545\35937\nclass HashableExample:\n    def __init__(self, x, y):\n        self.x = x\n        self.y = y\n    \n    def __hash__(self):\n        return hash((self.x, self.y))\n    \n    def __eq__(self, other):\n        return self.x == other.x and self.y == other.y\n\nobj1 = HashableExample(1, 2)\nobj2 = HashableExample(1, 2)\nobj3 = HashableExample(3, 4)\n\nprint(f\"obj1 == obj2: {obj1 == obj2}\")\nprint(f\"hash(obj1) == hash(obj2): {hash(obj1) == hash(obj2)}\")\n\n# \21487\20197\29992\20316\23383\20856\38190\25110\38598\21512\20803\32032\nd = {obj1: \"value1\", obj3: \"value3\"}\nprint(f\"\23383\20856: {d}\")\n\ns = {obj1, obj2, obj3}\nprint(f\"\38598\21512: {s}\")\n\n# 87. \24369\24341\29992\38598\21512\nimport weakref\n\nclass MyClass:\n    def __init__(self, name):\n        self.name = name\n    \n    def __repr__(self):\n        return f\"MyClass({self.name})\"\n\n# \21019\24314\23545\35937\nobj1 = MyClass(\"Object 1\")\nobj2 = MyClass(\"Object 2\")\n\n# \21019\24314\24369\24341\29992\38598\21512\nweak_set = weakref.WeakSet()\nweak_set.add(obj1)\nweak_set.add(obj2)\n\nprint(f\"\24369\24341\29992\38598\21512: {list(weak_set)}\")\n\n# \21024\38500\19968\20010\24341\29992\ndel obj2\nimport gc\ngc.collect()\n\nprint(f\"\21024\38500obj2\21518\30340\24369\24341\29992\38598\21512: {list(weak_set)}\")\n\n# 88. \24369\24341\29992\23383\20856\nweak_dict = weakref.WeakValueDictionary()\nweak_dict[\"key1\"] = MyClass(\"Value 1\")\nweak_dict[\"key2\"] = MyClass(\"Value 2\")\n\nprint(f\"\24369\24341\29992\23383\20856: {dict(weak_dict)}\")\n\n# \21024\38500\19968\20010\24341\29992\ntry:\n    value1 = weak_dict[\"key1\"]\n    del weak_dict[\"key1\"]\n    gc.collect()\n    print(f\"\21024\38500key1\21518\30340\24369\24341\29992\23383\20856: {dict(weak_dict)}\")\nexcept KeyError as e:\n    print(f\"\24369\24341\29992\23383\20856\38169\35823: {e}\")\n    print(f\"\24403\21069\24369\24341\29992\23383\20856: {dict(weak_dict)}\")\n\n# 89. \19981\21487\21464\38598\21512\nimmutable_set = frozenset([1, 2, 3])\nprint(f\"\19981\21487\21464\38598\21512: {immutable_set}\")\n\n# \23581\35797\20462\25913\20250\24341\21457\38169\35823\ntry:\n    immutable_set.add(4)\nexcept AttributeError as e:\n    print(f\"\38169\35823: {e}\")\n\n# 90. \19981\21487\21464\23383\20856\nfrom types import MappingProxyType\n\nmutable_dict = {'a': 1, 'b': 2}\nimmutable_dict = MappingProxyType(mutable_dict)\n\nprint(f\"\19981\21487\21464\23383\20856: {immutable_dict}\")\n\n# \23581\35797\20462\25913\20250\24341\21457\38169\35823\ntry:\n    immutable_dict['c'] = 3\nexcept TypeError as e:\n    print(f\"\38169\35823: {e}\")\n\n# \21407\22987\23383\20856\21487\20197\20462\25913\nmutable_dict['c'] = 3\nprint(f\"\21407\22987\23383\20856\20462\25913\21518: {immutable_dict}\")\n\n# 91. \19978\19979\25991\21464\37327\nimport contextvars\n\n# \21019\24314\19978\19979\25991\21464\37327\nuser_var = contextvars.ContextVar('user', default='Anonymous')\nrequest_var = contextvars.ContextVar('request', default=None)\n\ndef process_request():\n    user = user_var.get()\n    request = request_var.get()\n    print(f\"\22788\29702\35831\27714 - \29992\25143: {user}, \35831\27714: {request}\")\n\n# \35774\32622\19978\19979\25991\21464\37327\ntoken1 = user_var.set(\"Alice\")\ntoken2 = request_var.set(\"GET /api/users\")\n\nprocess_request()\n\n# \37325\32622\19978\19979\25991\21464\37327\nuser_var.reset(token1)\nrequest_var.reset(token2)\n\nprocess_request()\n\n# 92. \31867\22411\26816\26597\nfrom typing import get_type_hints\n\ndef example_function(x: int, y: str) -> bool:\n    return str(x) in y\n\n# \33719\21462\31867\22411\25552\31034\nhints = get_type_hints(example_function)\nprint(f\"\31867\22411\25552\31034: {hints}\")\n\n# 93. \31867\22411\21035\21517\nfrom typing import List, Dict, Union\n\nUserId = int\nUserName = str\nUserInfo = Dict[str, Union[str, int, List[str]]]\n\ndef process_user(user_id: UserId, user_name: UserName, user_info: UserInfo) -> None:\n    print(f\"\22788\29702\29992\25143: ID={user_id}, \21517\31216={user_name}, \20449\24687={user_info}\")\n\n# 94. \27867\22411\31867\22411\nfrom typing import TypeVar, Generic, List\n\nT = TypeVar('T')\n\nclass Stack(Generic[T]):\n    def __init__(self):\n        self._items: List[T] = []\n    \n    def push(self, item: T) -> None:\n        self._items.append(item)\n    \n    def pop(self) -> T:\n        return self._items.pop()\n    \n    def is_empty(self) -> bool:\n        return len(self._items) == 0\n\n# \20351\29992\27867\22411\26632\nint_stack = Stack[int]()\nint_stack.push(1)\nint_stack.push(2)\nprint(f\"\24377\20986\25972\25968: {int_stack.pop()}\")\n\nstr_stack = Stack[str]()\nstr_stack.push(\"Hello\")\nstr_stack.push(\"World\")\nprint(f\"\24377\20986\23383\31526\20018: {str_stack.pop()}\")\n\n# 95. \21327\35758\nfrom typing import Protocol, runtime_checkable\n\n@runtime_checkable\nclass Drawable(Protocol):\n    def draw(self) -> str:\n        ...\n\nclass Circle:\n    def draw(self) -> str:\n        return \"\32472\21046\22278\24418\"\n\nclass Square:\n    def draw(self) -> str:\n        return \"\32472\21046\27491\26041\24418\"\n\ndef render_shape(shape: Drawable) -> None:\n    print(shape.draw())\n\ncircle = Circle()\nsquare = Square()\n\nrender_shape(circle)\nrender_shape(square)\n\n# \26816\26597\21327\35758\23454\29616\nprint(f\"Circle\26159\21542\23454\29616Drawable: {isinstance(circle, Drawable)}\")\nprint(f\"Square\26159\21542\23454\29616Drawable: {isinstance(square, Drawable)}\")\n\n# 96. \21487\35843\29992\23545\35937\nclass CallableExample:\n    def __init__(self, multiplier):\n        self.multiplier = multiplier\n    \n    def __call__(self, value):\n        return self.multiplier * value\n\ndouble = CallableExample(2)\ntriple = CallableExample(3)\n\nprint(f\"\21452\20493: {double(5)}\")\nprint(f\"\19977\20493: {triple(5)}\")\n\n# 97. \25551\36848\31526\nclass ValidatedAttribute:\n    \"\"\"\39564\35777\23646\24615\25551\36848\31526\"\"\"\n    def __init__(self, name, type_, default=None):\n        self.name = name\n        self.type_ = type_\n        self.default = default\n    \n    def __get__(self, obj, objtype=None):\n        if obj is None:\n            return self\n        value = obj.__dict__.get(self.name, self.default)\n        if value is None:\n            return None\n        if not isinstance(value, self.type_):\n            raise TypeError(f\"{self.name} \24517\39035\26159 {self.type_}\")\n        return value\n    \n    def __set__(self, obj, value):\n        if value is not None and not isinstance(value, self.type_):\n            raise TypeError(f\"{self.name} \24517\39035\26159 {self.type_}\")\n        obj.__dict__[self.name] = value\n\nclass Person:\n    name = ValidatedAttribute(\"name\", str)\n    age = ValidatedAttribute(\"age\", int, 0)\n    height = ValidatedAttribute(\"height\", float)\n\nperson = Person()\nperson.name = \"Alice\"\nperson.age = 30\nperson.height = 170.5\n\nprint(f\"\22995\21517: {person.name}, \24180\40836: {person.age}, \36523\39640: {person.height}\")\n\ntry:\n    person.age = \"\19977\21313\"  # \36825\23558\24341\21457TypeError\nexcept TypeError as e:\n    print(f\"\38169\35823: {e}\")\n\n# 98. \25277\35937\22522\31867\nfrom abc import ABC, abstractmethod\n\nclass Shape(ABC):\n    @abstractmethod\n    def area(self) -> float:\n        pass\n    \n    @abstractmethod\n    def perimeter(self) -> float:\n        pass\n\nclass Rectangle(Shape):\n    def __init__(self, width, height):\n        self.width = width\n        self.height = height\n    \n    def area(self) -> float:\n        return self.width * self.height\n    \n    def perimeter(self) -> float:\n        return 2 * (self.width + self.height)\n\nrect = Rectangle(5, 3)\nprint(f\"\30697\24418\38754\31215: {rect.area()}\")\nprint(f\"\30697\24418\21608\38271: {rect.perimeter()}\")\n\n# 99. \20803\31867\nclass Meta(type):\n    def __new__(cls, name, bases, dct):\n        # \28155\21152\31867\23646\24615\n        dct['created_by'] = 'MetaClass'\n        # \28155\21152\31867\26041\27861\n        def get_class_name(cls):\n            return cls.__name__\n        dct['get_class_name'] = classmethod(get_class_name)\n        return super().__new__(cls, name, bases, dct)\n\nclass MyClass(metaclass=Meta):\n    pass\n\nprint(f\"\21019\24314\32773: {MyClass.created_by}\")\nprint(f\"\31867\21517: {MyClass.get_class_name()}\")\n\n# 100. \25968\25454\31867\nfrom dataclasses import dataclass, field\nfrom typing import List\n\n@dataclass\nclass Product:\n    name: str\n    price: float\n    quantity: int = 1\n    tags: List[str] = field(default_factory=list)\n    \n    def total_value(self) -> float:\n        return self.price * self.quantity\n\nproduct = Product(\"Laptop\", 999.99, 2, [\"electronics\", \"computer\"])\nprint(f\"\20135\21697: {product.name}, \24635\20215: {product.total_value()}, \26631\31614: {product.tags}\")\n\n# 101. \26522\20030\nfrom enum import Enum, auto, unique\n\n@unique\nclass Color(Enum):\n    RED = auto()\n    GREEN = auto()\n    BLUE = auto()\n\nclass Status(Enum):\n    PENDING = \"pending\"\n    APPROVED = \"approved\"\n    REJECTED = \"rejected\"\n\nprint(f\"\39068\33394: {Color.RED}\")\nprint(f\"\29366\24577: {Status.PENDING.value}\")\n\n# 102. \24322\27493\32534\31243\nimport asyncio\n\nasync def say_after(delay, what_to_say):\n    await asyncio.sleep(delay)\n    print(what_to_say)\n\nasync def main():\n    task1 = asyncio.create_task(say_after(1, \"Hello\"))\n    task2 = asyncio.create_task(say_after(2, \"World\"))\n    \n    await task1\n    await task2\n\n# asyncio.run(main())  # \27880\37322\25481\65292\36991\20813\22312\27979\35797\26102\36816\34892\n\n# 103. \24322\27493\19978\19979\25991\31649\29702\22120\nclass AsyncContextManager:\n    async def __aenter__(self):\n        print(\"\36827\20837\24322\27493\19978\19979\25991\")\n        return self\n    \n    async def __aexit__(self, exc_type, exc_val, exc_tb):\n        print(\"\36864\20986\24322\27493\19978\19979\25991\")\n        return False\n\nasync def use_async_context():\n    async with AsyncContextManager():\n        print(\"\22312\24322\27493\19978\19979\25991\20013\")\n\n# asyncio.run(use_async_context())  # \27880\37322\25481\65292\36991\20813\22312\27979\35797\26102\36816\34892\n\n# 104. \24322\27493\36845\20195\22120\nclass AsyncIterator:\n    def __init__(self, n):\n        self.n = n\n        self.i = 0\n    \n    def __aiter__(self):\n        return self\n    \n    async def __anext__(self):\n        if self.i >= self.n:\n            raise StopAsyncIteration\n        self.i += 1\n        await asyncio.sleep(0.1)\n        return self.i\n\nasync def use_async_iterator():\n    async for i in AsyncIterator(5):\n        print(f\"\24322\27493\36845\20195: {i}\")\n\n# asyncio.run(use_async_iterator())  # \27880\37322\25481\65292\36991\20813\22312\27979\35797\26102\36816\34892\n\n# 105. \24322\27493\29983\25104\22120\nasync def async_generator(n):\n    for i in range(n):\n        await asyncio.sleep(0.1)\n        yield i\n\nasync def use_async_generator():\n    async for i in async_generator(5):\n        print(f\"\24322\27493\29983\25104\22120: {i}\")\n\n# asyncio.run(use_async_generator())  # \27880\37322\25481\65292\36991\20813\22312\27979\35797\26102\36816\34892\n\n# 106. \20301\32622\21442\25968\21644\20851\38190\23383\21442\25968\ndef example_func(a, b, /, c, d, *, e, f):\n    print(f\"a={a}, b={b}, c={c}, d={d}, e={e}, f={f}\")\n\nexample_func(1, 2, 3, d=4, e=5, f=6)\n\n# 107. \36171\20540\34920\36798\24335\65288\28023\35937\36816\31639\31526\65289\nnumbers = [1, 2, 3, 4, 5]\nwhile (n := len(numbers)) > 0:\n    popped = numbers.pop()\n    print(f\"\24377\20986: {popped}, \21097\20313: {n-1}\")\n\n# 108. \32467\26500\21270\27169\24335\21305\37197\ndef match_example(value):\n    match value:\n        case 0:\n            print(\"\38646\")\n        case 1:\n            print(\"\19968\")\n        case [x, y]:\n            print(f\"\21015\34920\65292\20803\32032: {x}, {y}\")\n        case {\"name\": name, \"age\": age}:\n            print(f\"\23383\20856\65292\22995\21517: {name}, \24180\40836: {age}\")\n        case _:\n            print(\"\20854\20182\")\n\nmatch_example(0)\nmatch_example([1, 2])\nmatch_example({\"name\": \"Bob\", \"age\": 25})\nmatch_example(\"test\")\n\n# 109. \20301\32622\21442\25968\35299\21253\ndef add(a, b, c):\n    return a + b + c\n\nvalues = [1, 2, 3]\nresult = add(*values)\nprint(f\"\35299\21253\32467\26524: {result}\")\n\n# 110. \20851\38190\23383\21442\25968\35299\21253\ndef greet(name, greeting):\n    return f\"{greeting}, {name}!\"\n\nparams = {\"name\": \"Alice\", \"greeting\": \"Hello\"}\nresult = greet(**params)\nprint(f\"\20851\38190\23383\35299\21253\32467\26524: {result}\")\n\n# 111. \38142\24335\27604\36739\nx = 10\nif 0 < x < 20:\n    print(\"x \22312 0 \21644 20 \20043\38388\")\n\n# 112. \20301\36816\31639\na = 60  # 0011 1100\nb = 13  # 0000 1101\n\nprint(f\"a & b = {a & b}\")   # 12 (0000 1100)\nprint(f\"a | b = {a | b}\")   # 61 (0011 1101)\nprint(f\"a ^ b = {a ^ b}\")   # 49 (0011 0001)\nprint(f\"~a = {~a}\")         # -61 (1100 0011)\nprint(f\"a << 2 = {a << 2}\") # 240 (1111 0000)\nprint(f\"a >> 2 = {a >> 2}\") # 15 (0000 1111)\n\n# 113. \36816\31639\31526\37325\36733\nclass Vector:\n    def __init__(self, x, y):\n        self.x = x\n        self.y = y\n    \n    def __add__(self, other):\n        return Vector(self.x + other.x, self.y + other.y)\n    \n    def __sub__(self, other):\n        return Vector(self.x - other.x, self.y - other.y)\n    \n    def __mul__(self, scalar):\n        return Vector(self.x * scalar, self.y * scalar)\n    \n    def __eq__(self, other):\n        return self.x == other.x and self.y == other.y\n    \n    def __str__(self):\n        return f\"Vector({self.x}, {self.y})\"\n\nv1 = Vector(1, 2)\nv2 = Vector(3, 4)\n\nprint(f\"v1 + v2 = {v1 + v2}\")\nprint(f\"v1 - v2 = {v1 - v2}\")\nprint(f\"v1 * 3 = {v1 * 3}\")\nprint(f\"v1 == v2 = {v1 == v2}\")\n\n# 114. \21333\20363\27169\24335\nclass Singleton:\n    _instance = None\n    \n    def __new__(cls):\n        if cls._instance is None:\n            cls._instance = super().__new__(cls)\n        return cls._instance\n\ns1 = Singleton()\ns2 = Singleton()\nprint(f\"s1 \26159 s2: {s1 is s2}\")\n\n# 115. \24037\21378\27169\24335\nclass Dog:\n    def speak(self):\n        return \"Woof!\"\n\nclass Cat:\n    def speak(self):\n        return \"Meow!\"\n\ndef animal_factory(animal_type):\n    if animal_type == \"dog\":\n        return Dog()\n    elif animal_type == \"cat\":\n        return Cat()\n    else:\n        raise ValueError(f\"\26410\30693\21160\29289\31867\22411: {animal_type}\")\n\ndog = animal_factory(\"dog\")\ncat = animal_factory(\"cat\")\nprint(f\"\29399\35828: {dog.speak()}\")\nprint(f\"\29483\35828: {cat.speak()}\")\n\n# 116. \35266\23519\32773\27169\24335\nclass Subject:\n    def __init__(self):\n        self._observers = []\n        self._state = None\n    \n    def attach(self, observer):\n        if observer not in self._observers:\n            self._observers.append(observer)\n    \n    def detach(self, observer):\n        try:\n            self._observers.remove(observer)\n        except ValueError:\n            pass\n    \n    def notify(self):\n        for observer in self._observers:\n            observer.update(self)\n    \n    @property\n    def state(self):\n        return self._state\n    \n    @state.setter\n    def state(self, value):\n        self._state = value\n        self.notify()\n\nclass Observer:\n    def update(self, subject):\n        print(f\"\35266\23519\32773\25910\21040\26356\26032: {subject.state}\")\n\nsubject = Subject()\nobserver1 = Observer()\nobserver2 = Observer()\n\nsubject.attach(observer1)\nsubject.attach(observer2)\n\nsubject.state = \"\26032\29366\24577\"\n\n# 117. \31574\30053\27169\24335\nclass Strategy:\n    def execute(self, a, b):\n        pass\n\nclass AddStrategy(Strategy):\n    def execute(self, a, b):\n        return a + b\n\nclass SubtractStrategy(Strategy):\n    def execute(self, a, b):\n        return a - b\n\nclass MultiplyStrategy(Strategy):\n    def execute(self, a, b):\n        return a * b\n\nclass Context:\n    def __init__(self, strategy):\n        self._strategy = strategy\n    \n    def set_strategy(self, strategy):\n        self._strategy = strategy\n    \n    def execute_strategy(self, a, b):\n        return self._strategy.execute(a, b)\n\ncontext = Context(AddStrategy())\nprint(f\"\21152\27861: {context.execute_strategy(5, 3)}\")\n\ncontext.set_strategy(SubtractStrategy())\nprint(f\"\20943\27861: {context.execute_strategy(5, 3)}\")\n\ncontext.set_strategy(MultiplyStrategy())\nprint(f\"\20056\27861: {context.execute_strategy(5, 3)}\")\n\n# 118. \35013\39280\22120\27169\24335\nclass Coffee:\n    def cost(self):\n        return 5\n    \n    def description(self):\n        return \"\22522\30784\21654\21857\"\n\nclass MilkDecorator:\n    def __init__(self, coffee):\n        self._coffee = coffee\n    \n    def cost(self):\n        return self._coffee.cost() + 2\n    \n    def description(self):\n        return self._coffee.description() + \", \29275\22902\"\n\nclass SugarDecorator:\n    def __init__(self, coffee):\n        self._coffee = coffee\n    \n    def cost(self):\n        return self._coffee.cost() + 1\n    \n    def description(self):\n        return self._coffee.description() + \", \31958\"\n\ncoffee = Coffee()\nprint(f\"{coffee.description()}: ${coffee.cost()}\")\n\ncoffee_with_milk = MilkDecorator(coffee)\nprint(f\"{coffee_with_milk.description()}: ${coffee_with_milk.cost()}\")\n\ncoffee_with_milk_and_sugar = SugarDecorator(coffee_with_milk)\nprint(f\"{coffee_with_milk_and_sugar.description()}: ${coffee_with_milk_and_sugar.cost()}\")\n\n# 119. \19978\19979\25991\31649\29702\22120\35013\39280\22120\nfrom contextlib import contextmanager\n\n@contextmanager\ndef managed_resource(resource_name):\n    print(f\"\33719\21462\36164\28304: {resource_name}\")\n    try:\n        yield resource_name\n    finally:\n        print(f\"\37322\25918\36164\28304: {resource_name}\")\n\nwith managed_resource(\"\25968\25454\24211\36830\25509\"):\n    print(\"\20351\29992\36164\28304\")\n\n# 120. \20989\25968\27880\35299\ndef calculate(\n    a: float,\n    b: float,\n    operation: str = \"add\"\n) -> float:\n    if operation == \"add\":\n        return a + b\n    elif operation == \"subtract\":\n        return a - b\n    elif operation == \"multiply\":\n        return a * b\n    elif operation == \"divide\":\n        return a / b\n    else:\n        raise ValueError(f\"\26410\30693\25805\20316: {operation}\")\n\n# 121. \31867\22411\21035\21517\nfrom typing import List, Dict\n\nVector = List[float]\nMatrix = List[Vector]\nUserInfo = Dict[str, Union[str, int, List[int]]]\n\ndef dot_product(v1: Vector, v2: Vector) -> float:\n    return sum(x * y for x, y in zip(v1, v2))\n\n# 122. \27867\22411\nfrom typing import TypeVar, Generic\n\nT = TypeVar('T')\n\nclass Stack(Generic[T]):\n    def __init__(self):\n        self._items = []\n    \n    def push(self, item: T) -> None:\n        self._items.append(item)\n    \n    def pop(self) -> T:\n        return self._items.pop()\n    \n    def is_empty(self) -> bool:\n        return len(self._items) == 0\n\n# \20351\29992\27867\22411\26632\nint_stack = Stack[int]()\nint_stack.push(1)\nint_stack.push(2)\nprint(f\"\24377\20986\25972\25968: {int_stack.pop()}\")\n\nstr_stack = Stack[str]()\nstr_stack.push(\"Hello\")\nstr_stack.push(\"World\")\nprint(f\"\24377\20986\23383\31526\20018: {str_stack.pop()}\")\n\n# 123. \21327\35758\nfrom typing import Protocol\n\nclass Drawable(Protocol):\n    def draw(self) -> str:\n        ...\n\nclass Circle:\n    def draw(self) -> str:\n        return \"\32472\21046\22278\24418\"\n\nclass Square:\n    def draw(self) -> str:\n        return \"\32472\21046\27491\26041\24418\"\n\ndef render_shape(shape: Drawable) -> None:\n    print(shape.draw())\n\ncircle = Circle()\nsquare = Square()\n\nrender_shape(circle)\nrender_shape(square)\n\n# 124. \21487\35843\29992\23545\35937\nclass Adder:\n    def __init__(self, n):\n        self.n = n\n    \n    def __call__(self, x):\n        return self.n + x\n\nadd5 = Adder(5)\nprint(f\"5 + 3 = {add5(3)}\")\n\n# 125. \25551\36848\31526\21327\35758\nclass ValidatedAttribute:\n    def __init__(self, name, type_, default=None):\n        self.name = name\n        self.type_ = type_\n        self.default = default\n    \n    def __get__(self, obj, objtype=None):\n        if obj is None:\n            return self\n        value = obj.__dict__.get(self.name, self.default)\n        if value is None:\n            return None\n        if not isinstance(value, self.type_):\n            raise TypeError(f\"{self.name} \24517\39035\26159 {self.type_}\")\n        return value\n    \n    def __set__(self, obj, value):\n        if value is not None and not isinstance(value, self.type_):\n            raise TypeError(f\"{self.name} \24517\39035\26159 {self.type_}\")\n        obj.__dict__[self.name] = value\n\nclass Person:\n    name = ValidatedAttribute(\"name\", str)\n    age = ValidatedAttribute(\"age\", int, 0)\n    height = ValidatedAttribute(\"height\", float)\n\nperson = Person()\nperson.name = \"Alice\"\nperson.age = 30\nperson.height = 170.5\n\nprint(f\"\22995\21517: {person.name}, \24180\40836: {person.age}, \36523\39640: {person.height}\")\n\ntry:\n    person.age = \"\19977\21313\"  # \36825\23558\24341\21457TypeError\nexcept TypeError as e:\n    print(f\"\38169\35823: {e}\")\n\n# 126. \19978\19979\25991\31649\29702\22120\21327\35758\nclass Timer:\n    def __init__(self, name):\n        self.name = name\n        self.start = None\n        self.end = None\n    \n    def __enter__(self):\n        import time\n        self.start = time.time()\n        return self\n    \n    def __exit__(self, exc_type, exc_val, exc_tb):\n        import time\n        self.end = time.time()\n        elapsed = self.end - self.start\n        print(f\"{self.name} \32791\26102: {elapsed:.5f}\31186\")\n        return False  # \19981\25233\21046\24322\24120\n\nwith Timer(\"\20195\30721\22359\"):\n    import time\n    time.sleep(0.1)\n\n# 127. \36845\20195\22120\21327\35758\nclass Fibonacci:\n    def __init__(self, max_count):\n        self.max_count = max_count\n        self.count = 0\n        self.a, self.b = 0, 1\n    \n    def __iter__(self):\n        return self\n    \n    def __next__(self):\n        if self.count >= self.max_count:\n            raise StopIteration\n        self.count += 1\n        result = self.a\n        self.a, self.b = self.b, self.a + self.b\n        return result\n\nfor num in Fibonacci(10):\n    print(f\"\26000\27874\37027\22865\25968: {num}\")\n\n# 128. \21487\36845\20195\23545\35937\21327\35758\nclass Range:\n    def __init__(self, start, end, step=1):\n        self.start = start\n        self.end = end\n        self.step = step\n    \n    def __iter__(self):\n        return RangeIterator(self.start, self.end, self.step)\n\nclass RangeIterator:\n    def __init__(self, start, end, step):\n        self.current = start\n        self.end = end\n        self.step = step\n    \n    def __iter__(self):\n        return self\n    \n    def __next__(self):\n        if self.step > 0 and self.current >= self.end:\n            raise StopIteration\n        if self.step < 0 and self.current <= self.end:\n            raise StopIteration\n        \n        result = self.current\n        self.current += self.step\n        return result\n\nfor i in Range(1, 5):\n    print(f\"\33539\22260\25968: {i}\")\n\nfor i in Range(5, 0, -1):\n    print(f\"\20498\24207\33539\22260\25968: {i}\")\n\n# 129. \29983\25104\22120\34920\36798\24335\21644yield from\ndef chain(*iterables):\n    for it in iterables:\n        yield from it\n\nfor item in chain([1, 2], ['a', 'b'], [3, 4]):\n    print(f\"\38142\24335\39033: {item}\")\n\n# 130. \21327\31243\21644\24322\27493\29983\25104\22120\nasync def async_range(n):\n    for i in range(n):\n        yield i\n        await asyncio.sleep(0.1)\n\nasync def async_main():\n    async for num in async_range(5):\n        print(f\"\24322\27493\25968: {num}\")\n\n# asyncio.run(async_main())  # \27880\37322\25481\65292\36991\20813\22312\27979\35797\26102\36816\34892\n\n# 131. \31867\22411\26816\26597\nimport typing\n\ndef check_type(value, expected_type):\n    if not isinstance(value, expected_type):\n        raise TypeError(f\"\26399\26395 {expected_type}, \24471\21040 {type(value)}\")\n    return True\n\n# \20351\29992\31034\20363\ncheck_type(42, int)\ncheck_type(\"hello\", str)\n\ntry:\n    check_type(3.14, int)\nexcept TypeError as e:\n    print(f\"\31867\22411\38169\35823: {e}\")\n\n# 132. \24615\33021\20998\26512\nimport timeit\n\ndef test_performance():\n    total = 0\n    for i in range(1000):\n        total += i\n    return total\n\n# \27979\37327\25191\34892\26102\38388\nexecution_time = timeit.timeit(test_performance, number=1000)\nprint(f\"\25191\34892\26102\38388: {execution_time:.5f}\31186\")\n\n# 133. \20869\23384\20998\26512\nimport sys\n\ndef get_size(obj):\n    return sys.getsizeof(obj)\n\nprint(f\"\25972\25968\22823\23567: {get_size(42)} \23383\33410\")\nprint(f\"\23383\31526\20018\22823\23567: {get_size('hello')} \23383\33410\")\nprint(f\"\21015\34920\22823\23567: {get_size([1, 2, 3])} \23383\33410\")\n\n# 134. \20195\30721\23545\35937\21644\21160\24577\25191\34892\ncode_str = \"\"\"\ndef dynamic_function(x, y):\n    return x + y\n\nresult = dynamic_function(10, 20)\nprint(f\"\21160\24577\25191\34892\32467\26524: {result}\")\n\"\"\"\n\n# \32534\35793\24182\25191\34892\20195\30721\ncode_obj = compile(code_str, \"<string>\", \"exec\")\nexec(code_obj)\n\n# 135. \20989\25968\23646\24615\ndef example_function():\n    pass\n\n# \35774\32622\20989\25968\23646\24615\nexample_function.author = \"Alice\"\nexample_function.version = \"1.0\"\n\nprint(f\"\20989\25968\20316\32773: {example_function.author}\")\nprint(f\"\20989\25968\29256\26412: {example_function.version}\")\n\n# 136. \38381\21253\20013\30340\21464\37327\20316\29992\22495\ndef outer_function(x):\n    def inner_function(y):\n        return x + y\n    return inner_function\n\nadd5 = outer_function(5)\nprint(f\"\38381\21253\32467\26524: {add5(10)}\")\n\n# 137. nonlocal\21644global\20851\38190\23383\nx = 10  # \20840\23616\21464\37327\n\ndef modify_global():\n    global x\n    x = 20\n    print(f\"\20869\37096\20462\25913\20840\23616\21464\37327: {x}\")\n\ndef outer():\n    x = 5  # \22806\23618\20989\25968\21464\37327\n    \n    def inner():\n        nonlocal x\n        x = 10\n        print(f\"\20869\37096\20462\25913\22806\23618\21464\37327: {x}\")\n    \n    print(f\"\20462\25913\21069\22806\23618\21464\37327: {x}\")\n    inner()\n    print(f\"\20462\25913\21518\22806\23618\21464\37327: {x}\")\n\nprint(f\"\20840\23616\21464\37327\21021\22987\20540: {x}\")\nmodify_global()\nprint(f\"\20840\23616\21464\37327\20462\25913\21518: {x}\")\nouter()\n\n# 138. \20803\32452\35299\21253\na, b, c = (1, 2, 3)\nprint(f\"\20803\32452\35299\21253: a={a}, b={b}, c={c}\")\n\n# \20132\25442\21464\37327\na, b = b, a\nprint(f\"\20132\25442\21518: a={a}, b={b}\")\n\n# 139. \26143\21495\35299\21253\nfirst, *middle, last = [1, 2, 3, 4, 5]\nprint(f\"\39318\39033: {first}, \20013\38388\39033: {middle}, \26411\39033: {last}\")\n\n# 140. \23383\20856\35299\21253\ndict1 = {\"a\": 1, \"b\": 2}\ndict2 = {\"c\": 3, \"d\": 4}\nmerged_dict = {**dict1, **dict2}\nprint(f\"\21512\24182\23383\20856: {merged_dict}\")\n\n# 141. \38598\21512\25805\20316\nset1 = {1, 2, 3}\nset2 = {3, 4, 5}\n\nprint(f\"\24182\38598: {set1 | set2}\")\nprint(f\"\20132\38598: {set1 & set2}\")\nprint(f\"\24046\38598: {set1 - set2}\")\nprint(f\"\23545\31216\24046\38598: {set1 ^ set2}\")\n\n# 142. \21015\34920\26041\27861\nnumbers = [1, 2, 3, 4, 5]\nnumbers.append(6)\nnumbers.insert(0, 0)\nnumbers.extend([7, 8, 9])\nnumbers.remove(3)\npopped = numbers.pop()\nprint(f\"\24377\20986\20803\32032: {popped}\")\nprint(f\"\21015\34920: {numbers}\")\nprint(f\"\32034\24341: {numbers.index(4)}\")\nprint(f\"\35745\25968: {numbers.count(2)}\")\nnumbers.sort()\nprint(f\"\25490\24207\21518: {numbers}\")\nnumbers.reverse()\nprint(f\"\21453\36716\21518: {numbers}\")\n\n# 143. \23383\20856\26041\27861\nstudent = {\"name\": \"Alice\", \"age\": 25, \"courses\": [\"Math\", \"Science\"]}\nprint(f\"\38190: {student.keys()}\")\nprint(f\"\20540: {student.values()}\")\nprint(f\"\38190\20540\23545: {student.items()}\")\nprint(f\"\33719\21462\22995\21517: {student.get('name')}\")\nprint(f\"\33719\21462\25104\32489: {student.get('grades', 'N/A')}\")\nstudent.update({\"age\": 26, \"grades\": [85, 90, 95]})\nprint(f\"\26356\26032\21518: {student}\")\nremoved = student.pop('courses')\nprint(f\"\31227\38500\30340\35838\31243: {removed}\")\nprint(f\"\26368\32456\23383\20856: {student}\")\n\n# 144. \23383\31526\20018\26041\27861\ntext = \"  Hello, World!  \"\nprint(f\"\21435\38500\31354\30333: '{text.strip()}'\")\nprint(f\"\22823\20889: '{text.upper()}'\")\nprint(f\"\23567\20889: '{text.lower()}'\")\nprint(f\"\26367\25442: '{text.replace('World', 'Python')}'\")\nprint(f\"\20998\21106: '{text.split(',')}'\")\nprint(f\"\36830\25509: {'-'.join(['a', 'b', 'c'])}\")\nprint(f\"\26597\25214: '{text.find('World')}'\")\nprint(f\"\35745\25968: '{text.count('l')}'\")\nprint(f\"\26159\21542\20197Hello\24320\22836: {text.strip().startswith('Hello')}\")\nprint(f\"\26159\21542\20197World\32467\23614: {text.strip().endswith('World')}\")\n\n# 145. \26684\24335\21270\23383\31526\20018\nname = \"Alice\"\nage = 30\nheight = 1.65\n\n# f-strings (Python 3.6+)\nprint(f\"\22995\21517: {name}, \24180\40836: {age}, \36523\39640: {height:.2f}\31859\")\n\n# str.format()\nprint(\"\22995\21517: {}, \24180\40836: {}, \36523\39640: {:.2f}\31859\".format(name, age, height))\n\n# %\26684\24335\21270\nprint(\"\22995\21517: %s, \24180\40836: %d, \36523\39640: %.2f\31859\" % (name, age, height))\n\n# 146. \25991\20214\21644\30446\24405\25805\20316\nimport os\n\n# \33719\21462\24403\21069\24037\20316\30446\24405\nprint(f\"\24403\21069\24037\20316\30446\24405: {os.getcwd()}\")\n\n# \21015\20986\30446\24405\20869\23481\nprint(f\"\30446\24405\20869\23481: {os.listdir('.')}\")\n\n# \21019\24314\30446\24405\nos.makedirs(\"test_dir\", exist_ok=True)\n\n# \26816\26597\36335\24452\26159\21542\23384\22312\nprint(f\"test_dir\26159\21542\23384\22312: {os.path.exists('test_dir')}\")\n\n# \26816\26597\26159\21542\26159\30446\24405\nprint(f\"test_dir\26159\30446\24405: {os.path.isdir('test_dir')}\")\n\n# \26816\26597\26159\21542\26159\25991\20214\nprint(f\"test_dir\26159\25991\20214: {os.path.isfile('test_dir')}\")\n\n# \33719\21462\25991\20214\22823\23567\nwith open(\"test_file.txt\", \"w\") as f:\n    f.write(\"Hello, World!\")\nprint(f\"\25991\20214\22823\23567: {os.path.getsize('test_file.txt')} \23383\33410\")\n\n# \21024\38500\25991\20214\nos.remove(\"test_file.txt\")\n\n# \21024\38500\30446\24405\nos.rmdir(\"test_dir\")\n\n# 147. \36335\24452\25805\20316\nfrom pathlib import Path\n\n# \21019\24314Path\23545\35937\ncurrent_dir = Path(\".\")\nhome_dir = Path.home()\n\nprint(f\"\24403\21069\30446\24405: {current_dir.resolve()}\")\nprint(f\"\23478\30446\24405: {home_dir}\")\n\n# \21019\24314\36335\24452\nnew_dir = current_dir / \"example_dir\"\nnew_dir.mkdir(exist_ok=True)\n\n# \21019\24314\25991\20214\nfile_path = new_dir / \"example.txt\"\nfile_path.write_text(\"Hello, Path!\")\n\n# \35835\21462\25991\20214\nprint(f\"\25991\20214\20869\23481: {file_path.read_text()}\")\n\n# \36941\21382\30446\24405\nprint(\"\30446\24405\36941\21382:\")\nfor item in new_dir.iterdir():\n    print(f\"  {item.name}: {'\30446\24405' if item.is_dir() else '\25991\20214'}\")\n\n# \28165\29702\nfile_path.unlink()\nnew_dir.rmdir()\n\n# 148. \29615\22659\21464\37327\nimport os\n\n# \33719\21462\29615\22659\21464\37327\nprint(f\"PATH: {os.environ.get('PATH', '\26410\35774\32622')}\")\n\n# \35774\32622\29615\22659\21464\37327\nos.environ['MY_VAR'] = 'my_value'\nprint(f\"MY_VAR: {os.environ.get('MY_VAR')}\")\n\n# \21024\38500\29615\22659\21464\37327\nif 'MY_VAR' in os.environ:\n    del os.environ['MY_VAR']\nprint(f\"MY_VAR\21024\38500\21518: {os.environ.get('MY_VAR', '\26410\35774\32622')}\")\n\n# 149. \21629\20196\34892\21442\25968\nimport sys\n\n# \33719\21462\21629\20196\34892\21442\25968\nprint(f\"\33050\26412\21517\31216: {sys.argv[0]}\")\nprint(f\"\21442\25968\21015\34920: {sys.argv[1:]}\")\n\n# 150. \21629\20196\34892\21442\25968\35299\26512\nimport argparse\n\n# \21019\24314\35299\26512\22120\nparser = argparse.ArgumentParser(description='\31034\20363\33050\26412')\nparser.add_argument('--name', type=str, default='World', help='\22995\21517')\nparser.add_argument('--count', type=int, default=1, help='\35745\25968')\nparser.add_argument('--verbose', action='store_true', help='\35814\32454\36755\20986')\n\n# \27169\25311\35299\26512\21629\20196\34892\21442\25968\n# \22312\23454\38469\20351\29992\20013\65292\36825\20123\21442\25968\26469\33258\21629\20196\34892\nargs = parser.parse_args(['--name', 'Alice', '--count', '3', '--verbose'])\n\nprint(f\"\22995\21517: {args.name}\")\nprint(f\"\35745\25968: {args.count}\")\nprint(f\"\35814\32454\36755\20986: {args.verbose}\")\n\nprint(\"Python \25152\26377\35821\27861\29305\24615\31034\20363\25191\34892\23436\27605\65281\")", pstateOffset = 0, pstateSourcePos = SourcePos {sourceName = "./all_python_syntax.py", sourceLine = Pos 1, sourceColumn = Pos 1}, pstateTabWidth = Pos 8, pstateLinePrefix = ""}}
