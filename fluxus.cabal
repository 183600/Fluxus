    , bytestring >=0.11
    , containers >=0.6.7
    , deepseq >=1.4
    , directory >=1.3
    , fast-logger >=3.2
    , fgl >=5.8
    , filepath >=1.4
    , hashable >=1.4
    , lens >=5.2
    , megaparsec >=9.5
    , monad-logger >=0.3.40
    , mtl >=2.3
    , optparse-applicative >=0.17
    , parsec >=3.1.16
    , parser-combinators >=1.3
    , prettyprinter >=1.7
