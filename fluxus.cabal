cabal-version: 3.0
name: fluxus
version: 0.1.0.0
synopsis: High-performance hybrid C++ AOT compiler for Python and Go
description: Fluxus is an experimental hybrid Ahead-of-Time (AOT) compiler 
             that translates high-level languages (initially Python and Go) into 
             highly optimized modern C++ (C++20/23) while maintaining full language 
             compatibility through runtime interoperability.
license: Apache-2.0
license-file: LICENSE
author: Fluxus Team
maintainer: fluxus@example.com
copyright: 2024 Fluxus Team
category: Compiler
build-type: Simple
extra-source-files: README.md
extra-doc-files: CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/183600/Fluxus

flag fast
  description: Enable fast compilation mode (less optimization)
  default: False
  manual: True

flag production
  description: Enable production build mode (more optimization)
  default: False
  manual: True

common shared-properties
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
               -Wincomplete-uni-patterns -Wmissing-export-lists
               -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
               -Wno-missing-import-lists -Wunused-imports -Wunused-binds

library
  import: shared-properties
  hs-source-dirs: src
  if flag(fast)
    ghc-options: -O0
  if flag(production) 
    ghc-options: -O2
  exposed-modules:
    Fluxus.AST.Common
    Fluxus.AST.Python
    Fluxus.AST.Go
    Fluxus.Parser.Python.Lexer
    Fluxus.Parser.Python.Parser
    Fluxus.Parser.Go.Lexer
    Fluxus.Parser.Go.Parser
    Fluxus.Analysis.CommonExprLowering
    Fluxus.Analysis.TypeInference
    Fluxus.Analysis.EscapeAnalysis
    Fluxus.Analysis.ShapeAnalysis
    Fluxus.Analysis.OwnershipInference
    Fluxus.Analysis.SmartFallback
    Fluxus.Optimization.Monomorphization
    Fluxus.Optimization.Devirtualization
    Fluxus.CodeGen.CPP
    Fluxus.CodeGen.CPP.AST
    Fluxus.CodeGen.CPP.Diagnostics
    Fluxus.CodeGen.CPP.IdentifierSanitizer
    Fluxus.CodeGen.CPP.Go
    Fluxus.CodeGen.CPP.Monad
    Fluxus.CodeGen.CPP.Python
    Fluxus.CodeGen.CPP.Shared
    Fluxus.CodeGen.Go
    Fluxus.Runtime.Python
    Fluxus.Runtime.Go
    Fluxus.Compiler.Driver
    Fluxus.Compiler.Config
    Fluxus.Utils.Pretty
    Fluxus.Utils.Graph
    Fluxus.Utils.Debug
    Fluxus.Utils.Common
  other-modules:
    Fluxus.Internal.Types
    Fluxus.Internal.Monad
    Fluxus.CodeGen.CPP.Go.TypeMapping
    Fluxus.Parser.Go.Parser.Common
    Fluxus.Parser.Go.Parser.Declarations
    Fluxus.Parser.Go.Parser.Expressions
    Fluxus.Parser.Go.Parser.Statements
  
  
  build-depends:
    base >= 4.17 && < 5,
    containers >= 0.6.7 && < 0.9,
    text >= 2.0 && < 2.2,
    bytestring >= 0.11 && < 0.13,
    mtl >= 2.3 && < 2.4,
    transformers >= 0.6 && < 0.7,
    megaparsec >= 9.5 && < 9.8,
    prettyprinter >= 1.7 && < 1.8,
    prettyprinter-ansi-terminal >= 1.1 && < 1.2,
    hashable >= 1.4 && < 1.6,
    unordered-containers >= 0.2.19 && < 0.3,
    vector >= 0.13 && < 0.14,
    deepseq >= 1.4 && < 1.6,
    filepath >= 1.4 && < 1.6,
    directory >= 1.3 && < 1.4,
    process >= 1.6 && < 1.8,
    aeson >= 2.1 && < 2.3,
    yaml >= 0.11 && < 0.12,
    monad-logger >= 0.3.40 && < 0.4,
    time >= 1.12 && < 1.16,
    stm >= 2.5 && < 2.6,

executable fluxus
  import: shared-properties
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base,
    fluxus,
    text
  ghc-options: -threaded -rtsopts -with-rtsopts=-N

test-suite fluxus-test
  import: shared-properties
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules:
    Test.Fluxus.Parser.Python
    Test.Fluxus.Parser.Go
    Test.Fluxus.Analysis.CommonExprLowering
    Test.Fluxus.Analysis.ShapeAnalysis
    Test.Fluxus.Analysis.TypeInference
    Test.Fluxus.Analysis.EscapeAnalysis
    Test.Fluxus.Analysis.OwnershipInference
    Test.Fluxus.Analysis.SmartFallback
    Test.Fluxus.CodeGen.CPP
    Test.Fluxus.CodeGen.CPP.Shared
    Test.Fluxus.CodeGen.CPP.TypeMapping
    Test.Fluxus.CodeGen.CPP.UnsupportedConstructs
    Test.Fluxus.CodeGen.CPP.Python
    Test.Fluxus.CodeGen.CPP.PythonExtended
    Test.Fluxus.CodeGen.CPP.Go
    Test.Fluxus.Utils.GraphSpec
    Test.Fluxus.Compiler.ConfigSpec
    Test.Fluxus.Compiler.DriverSpec
    Test.Fluxus.QuickCheckProperties
    Test.Fluxus.BoundaryTests
    Test.Fluxus.AdditionalBoundaryTests
  build-depends:
    base,
    containers,
    directory,
    filepath,
    fluxus,
    hspec >= 2.10,
    process,
    QuickCheck >= 2.14,
    temporary,
    text,
    unordered-containers,
    mtl >= 2.3,
    vector
  ghc-options: -threaded -rtsopts -with-rtsopts=-N

benchmark fluxus-bench
  import: shared-properties
  type: exitcode-stdio-1.0
  hs-source-dirs: bench
  main-is: Bench.hs
  build-depends:
    base,
    fluxus,
    criterion >= 1.6,
    text,
    deepseq,
    unordered-containers,
    containers
  ghc-options: -threaded -rtsopts -with-rtsopts=-N

executable test-python-lexer
  import: shared-properties
  main-is: debug_python_lexer.hs
  hs-source-dirs: .
  build-depends:
    base,
    fluxus,
    text
  ghc-options: -threaded -rtsopts -with-rtsopts=-N

executable test-python-parser
  import: shared-properties
  main-is: test-debug.hs
  hs-source-dirs: .
  build-depends:
    base,
    fluxus,
    text
  ghc-options: -threaded -rtsopts -with-rtsopts=-N